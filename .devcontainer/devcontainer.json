{
  "name": "trunx",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "dev"
  },
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,
  // On a machine with an NVIDIA GPU, uncomment to expose it in the container:
  // "runArgs": ["--gpus=all"],
  "postCreateCommand": "uv sync --group dev && uv run pre-commit install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "astral-sh.ty"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
