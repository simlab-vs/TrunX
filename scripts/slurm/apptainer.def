Bootstrap: docker
From: nvidia/cuda:12.2.2-base-ubuntu22.04

%help
    Minimal container with a CUDA environment and Astral uv.

%labels
    Author Glory Mary Givi
    Version 1.0

%post -c /bin/bash
    # Install system dependencies
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
	r-base \
	r-base-dev \
	libopenblas-dev \
	liblapack-dev \
	libgomp1 \
	libgl1 \
        && rm -rf /var/lib/apt/lists/*

    # Install uv
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # Copy project files and install dependencies
    mkdir -p /app
    cd /app
    
    python3 -m venv .venv
    source .venv/bin/activate
    
    echo "Installing JAX with CUDA 12 support..."
    pip install --upgrade pip
    pip install --upgrade "jax[cuda12]" \
        -f https://storage.googleapis.com/jax-releases/jax_cuda_releases.html

    # Install everything else with uv (skip jax)
    echo "Installing remaining dependencies with uv..."
    
    uv sync --frozen --no-dev --no-cache --no-install-project \
        --no-install-package jax \
        --no-install-package jaxlib || true

%environment
    export PATH="/root/.local/bin:$PATH"
    export VIRTUAL_ENV="/app/.venv"
    export PATH="$VIRTUAL_ENV/bin:$PATH"

%files
    # Copy your project files into the container at build time
    pyproject.toml /app/pyproject.toml
    uv.lock /app/uv.lock
    README.md /app/README.md

%runscript
    export PYTHONPATH=/app/src:$PYTHONPATH
    exec uv run "$@"

%test
    uv --version --no-cache
    uv --no-cache run python --version
